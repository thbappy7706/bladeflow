{
    "name": "thbappy7706/bladeflow",
    "description": "Zero-reload SPA engine for Laravel Blade — no jQuery, no Livewire, no Inertia.",
    "type": "library",
    "license": "MIT",
    "authors": [{ "name": "Tanvir Hossen Bappy", "role": "Developer" }],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Thbappy7706\\BladeFlow\\": "src/"
        },
        "files": [
            "src/bladeflow-helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": ["Thbappy7706\\BladeFlow\\BladeFlowServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}